rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for User documents
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256;
    }

    // Validation for Transaction documents
    function isValidTransaction(data) {
      return data.userId is string && data.userId.size() <= 128
        && (data.type == 'income' || data.type == 'expense')
        && data.amount is number && data.amount >= 0
        && data.category is string && data.category.size() <= 64
        && data.date is string && data.date.size() <= 32;
    }

    // Validation for Category documents
    function isValidCategory(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 64
        && (data.type == 'income' || data.type == 'expense');
    }

    // Validation for Bill documents
    function isValidBill(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 128
        && data.amount is number && data.amount >= 0
        && data.dueDate is string && data.dueDate.size() <= 32
        && (data.status == 'unpaid' || data.status == 'paid' || data.status == 'overdue');
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if false;
    }

    // Financial Transactions
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidTransaction(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidTransaction(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Custom Categories
    match /categories/{categoryId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidCategory(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidCategory(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Monthly Bills & Reminders
    match /bills/{billId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidBill(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidBill(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Ayam Anugerah Warehouse Receipts
    match /receipts/{receiptId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
